<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .btn-success:hover {
      background-color: #6fdd8e !important;
    }
  </style>
</head>
<body class="bg-light d-flex justify-content-center align-items-center vh-100">
  <% if (req.query.error === 'UserAlreadyExists') { %>
    <script>alert('Please Enter Correct Email or Password');</script>
  <% } %>
  <div class="card p-4 shadow" style="min-width: 300px; max-width: 400px;">
    <h2 class="text-center mb-4">Login</h2>
    <form method="POST" action="/auth/login">
      <div class="mb-3">
        <input type="text" name="username" class="form-control" placeholder="Username" required />
      </div>
      <div class="mb-3">
        <input type="password" name="password" class="form-control" placeholder="Password" required />
      </div>
      <button type="submit" class="btn btn-success w-100">Login</button>
    </form>
    <p class="mt-3 text-center">Don't have an account? <a href="/auth/register">Register</a></p>
  </div>

</body>
</html>

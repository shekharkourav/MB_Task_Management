<!DOCTYPE html>
<html>
<head>
  <title>Task Detail</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex justify-content-center align-items-center vh-100">

  <div class="card shadow p-4" style="max-width: 600px; width: 100%;">
    <h2 class="card-title mb-3"><%= task.title %></h2>
    <p><strong>Description:</strong> <%= task.description %></p>
    <p><strong>Due Date:</strong> <%= task.dueDate.toDateString() %></p>
    <p><strong>Status:</strong> <%= task.status %></p>
    <p><strong>Priority:</strong> <%= task.priority %></p>

    <div class="d-flex gap-2 mt-3">
      <a href="/tasks/<%= task._id %>/edit" class="btn btn-warning">Edit</a>
      <form action="/tasks/<%= task._id %>/delete" method="POST" onsubmit="return confirm('Are you sure?');">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
      <a href="/tasks" class="btn btn-secondary ms-auto">Back to list</a>
    </div>
  </div>

</body>
</html>
